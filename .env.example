# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (required — app fails to build/run without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Blob (required — waitlist/subscribe storage)
BLOB_READ_WRITE_TOKEN=

# Resend (required for email sending)
RESEND_API_KEY=
# Optional — falls back to "Freelens <onboarding@resend.dev>" if unset
RESEND_FROM=

# AI draft generation
ANTHROPIC_API_KEY=
FRONTDESK_DRAFT_MODEL=
REBOOKING_DRAFT_MODEL=

# Site config
# Optional — falls back to https://freelens-mvp.vercel.app if unset
NEXT_PUBLIC_SITE_URL=
# No fallback — footer contact link is blank if unset
NEXT_PUBLIC_CONTACT_EMAIL=

# Admin + cron
ADMIN_EMAILS=
CRON_SECRET=

# Waitlist double-opt-in token signing
WAITLIST_SECRET=
